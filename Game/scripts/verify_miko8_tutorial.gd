extends SceneTree
var level:Node3D
var a:CharacterBody3D
func _initialize()->void:call_deferred("run")
func ticks(n:int)->void:
	for i in range(n):await physics_frame
func capture(label:String)->void:
	await process_frame
	await RenderingServer.frame_post_draw
	root.get_texture().get_image().save_png("res://../Builds/Validation/MIKO8/reactions/tutorial_"+label+".png")
func run()->void:
	level=load("res://scenes/miko8_tutorial.tscn").instantiate()
	root.add_child(level)
	a=level.actor
	assert(a.clips.size()==48)
	assert(level.parallax.size()==5)
	await ticks(140)
	assert(a.state=="GroundSitIdle" and a.is_on_floor())
	await capture("wake")
	Input.action_press("miko8_right",0.35)
	await ticks(150)
	assert(a.state=="Locomotion" and a.current_clip=="Walk")
	await ticks(75)
	assert(level.walk_distance>0.75)
	Input.action_press("miko8_right",0.65)
	await ticks(70)
	assert(level.run_distance>1.5)
	Input.action_release("miko8_right")
	await ticks(30)
	await capture("first_room")
	# Walk the full sit-enter/idle/exit cycle without a root-position snap.
	a.reactions.sit()
	await ticks(160)
	assert(a.state=="GroundSitIdle")
	Input.action_press("miko8_right",0.35)
	await ticks(145)
	assert(a.current_clip=="Walk" and a.head_offset.active)
	Input.action_release("miko8_right")
	await ticks(25)
	# Clear the maintenance channel with the accepted jump controller.
	a.reset_actor()
	a.position=Vector3(15.6,0.02,0)
	await ticks(5)
	Input.action_press("miko8_right",0.65)
	await ticks(19)
	a._begin_jump()
	await ticks(63)
	assert(a.position.x>18.4 and a.position.y>-0.1,"Channel must be jumpable")
	Input.action_release("miko8_right")
	await ticks(25)
	assert(a.is_on_floor())
	await capture("courtyard")
	# The real, fixed tutorial crate must block walking and allow jump clearance.
	a.reset_actor()
	a.position=Vector3(24.0,0.02,0)
	await ticks(5)
	Input.action_press("miko8_right",0.65)
	await ticks(80)
	assert(a.position.x<24.4 and a.state=="WallBlocked")
	a._begin_jump()
	await ticks(80)
	assert(a.position.x>25.6,"Jump must clear the metal crate")
	Input.action_release("miko8_right")
	await ticks(25)
	await capture("end_room")
	assert(a.position.z==0)
	# A missed jump has a solid, shallow landing and a recoverable exit.
	a.reset_actor()
	a.position=Vector3(17.7,-0.86,0)
	await ticks(10)
	assert(a.is_on_floor())
	Input.action_press("miko8_right",0.65)
	a._begin_jump()
	await ticks(85)
	Input.action_release("miko8_right")
	await ticks(30)
	assert(a.position.x>18.4 and a.position.y>-0.1 and a.is_on_floor())
	# End-state prompts, camera bounds and differing parallax displacement.
	a.position=Vector3(29.3,0.02,0)
	await ticks(45)
	assert(level.completed and level.phase==5)
	assert(level.camera.position.x<=22.001)
	assert(level.parallax[0].node.position.x>level.parallax[3].node.position.x)
	await capture("complete")
	await level._restart(true)
	assert(a.state=="GroundSitIdle" and a.is_physics_processing())
	assert(level.phase==0 and not level.completed and level.walk_distance==0)
	assert(level.fade.color.a<0.01 and not level.resetting)
	print("TUTORIAL_PASS: 48 clips; seated wake, all sit transitions, walk/run progress, channel jump, crate collision/jump, camera limits and parallax structure")
	quit()
